# Docker-compose default env — fine for local/staging spin-up via
# `docker compose up`. Before using this for a real production deploy,
# regenerate APP_KEY (`php artisan key:generate --show`) and DB_PASSWORD,
# and fill in real MAIL_* credentials.
APP_NAME="Agency Management System"
APP_ENV=production
APP_KEY=base64:OyAgJ4+d5UGewowLdutabeFxTF+jryqaK56gDhUuDpc=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=agency
DB_USERNAME=agency
DB_PASSWORD=9dc9e23b8b037e739c630ea3b257d07f

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Fill in real SMTP credentials to actually send mail (client portal
# invites, password resets, etc). Until then this logs to storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
